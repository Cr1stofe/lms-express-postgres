# ==========================================
# Configurações do Servidor e Domínio
# ==========================================
SERVER_NAME=localhost
ACME_EMAIL=admin@seudominio.com

# ==========================================
# Configurações de E-mail (Resend)
# ==========================================
FROM_EMAIL=noreply@seudominio.com

# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lms
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# URL de conexão para o Prisma ORM (host local ou container)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms?schema=public"

# ==========================================
# Caminhos de Armazenamento
# ==========================================
FILES_PATH=/files

# Para execução LOCAL (fora do Docker):
# FILES_PATH=./files
# EMAIL_KEY_FILE=./secrets/email_key.txt
# PEPPER_FILE=./secrets/pepper.txt
